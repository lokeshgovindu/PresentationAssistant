<Window x:Class="PresentationAssistant.PresentationAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:PA="clr-namespace:PresentationAssistant"
        mc:Ignorable="d"
        d:DataContext="{x:Static PA:SampleData.MultiplierShortcut}"
        Width="Auto" Height="Auto"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        Background="{DynamicResource PA.BackgroundBrush}"
        Foreground="{DynamicResource PA.ForegroundBrush}"
        FontSize="24"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        Opacity="0.85">

    <Window.Resources>
        <!-- Fallbacks for the designer. ApplyTheme replaces these entries at runtime,
             which is why every consumer below uses DynamicResource. -->
        <SolidColorBrush x:Key="PA.BackgroundBrush"          Color="#DCF2DC" />
        <SolidColorBrush x:Key="PA.ForegroundBrush"          Color="#1E1E1E" />
        <SolidColorBrush x:Key="PA.SecondaryForegroundBrush" Color="#5A6B5A" />
        <SolidColorBrush x:Key="PA.BorderBrush"              Color="#7FA97F" />
    </Window.Resources>

    <!-- Plain TextBlocks with margins rather than Runs and literal spaces: Run.Text binds
         TwoWay by default, which throws on the get-only properties below, and spacing has
         to come from margins so the same tree works in either layout. Visibility and
         spacing are set in ApplyStyle rather than bound, so they are settled before the
         window is revealed. -->
    <Border BorderThickness="1"
            BorderBrush="{DynamicResource PA.BorderBrush}"
            Padding="10 5 10 5">
        <StackPanel Name="CommandText"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- "Scroll Line Down". No ToolTip: the window is click-through
                 (WS_EX_TRANSPARENT) so it never sees the mouse. The full command id goes
                 to the status bar instead. -->
            <TextBlock Name="DescriptionText"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Text="{Binding Description, Mode=OneWay}" />

            <StackPanel Name="DetailPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Name="ViaText"
                           Text="via"
                           Foreground="{DynamicResource PA.SecondaryForegroundBrush}" />
                <TextBlock Name="ShortcutsText"
                           Margin="6 0 0 0"
                           Foreground="{DynamicResource PA.SecondaryForegroundBrush}"
                           Text="{Binding ShortcutsStr, Mode=OneWay}" />
                <TextBlock Name="MultiplierText"
                           Margin="8 0 0 0"
                           Foreground="{DynamicResource PA.SecondaryForegroundBrush}"
                           Text="{Binding MultiplierStr, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
